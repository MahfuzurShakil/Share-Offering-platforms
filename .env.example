# Copy to .env and fill in. Never commit a real secret.

# PostgreSQL. The app has its own role; the superuser is for administration only.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/sharesale_dev?schema=public"
# A separate database for the test suite — it is truncated between tests.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@127.0.0.1:5432/sharesale_test?schema=public"

# Guards the demo-data script and the reference-data seed. Never "true" in production.
ALLOW_SEED="false"
