// Share-Sale & Investor Management Platform — database schema.
//
// Written module by module in stage order (PHASE-1-PLAN.md §Stages). This file
// holds S1: the foundation every other module stands on — reference data,
// people and how they sign in, what they may do, the audit trail, display-code
// numbering, documents, and projects.
//
// Conventions, so the rest of the schema reads the same way:
//   * model PascalCase, table snake_case via @@map; columns stay snake_case
//   * id  String @id @default(uuid(7)) @db.Uuid
//   * created_at / updated_at / created_by on every entity
//   * money Decimal(18,2), share percentages Decimal(9,6) — never Float
//   * dates that are days (a due date, a signing date) are @db.Date;
//     moments in time are @db.Timestamptz
//   * `deleted_at` is the soft-delete marker on records people manage.
//     Financial rows never carry one: they are immutable and corrected by a
//     reversing entry (AGENTS.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ------------------------------------------------------------------ *
 * Reference data and company settings
 * ------------------------------------------------------------------
 */

/// Every option list the client edits themselves: amenities, income and
/// expense heads, designations, document types. Statuses are NOT here — they
/// are ENUMs in code, because the software branches on them.
model LookupValue {
  id         String    @id @default(uuid(7)) @db.Uuid
  category   String    @db.VarChar(64)
  /// for category='document_type' this is the entity_type it belongs to
  scope      String?   @db.VarChar(64)
  value      String    @db.VarChar(200)
  /// the stable machine key a record stores, where a label would be unsafe to rename
  code       String?   @db.VarChar(64)
  is_active  Boolean   @default(true)
  sort_order Int       @default(0)
  /// a seeded row the client may rename but not delete
  is_system  Boolean   @default(false)
  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  created_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz

  @@unique([category, scope, value])
  @@index([category, is_active, sort_order])
  @@map("lookup_values")
}

/// One row. The company's own details, as they appear on documents and the
/// public site.
model CompanySettings {
  id                     String   @id @default(uuid(7)) @db.Uuid
  company_name           String   @db.VarChar(200)
  legal_name             String?  @db.VarChar(200)
  tagline                String?  @db.VarChar(300)
  about                  String?
  phone                  String?  @db.VarChar(40)
  alt_phone              String?  @db.VarChar(40)
  email                  String?  @db.VarChar(200)
  website                String?  @db.VarChar(200)
  address                String?
  tax_id                 String?  @db.VarChar(60)
  trade_licence_no       String?  @db.VarChar(60)
  rehab_member_no        String?  @db.VarChar(60)
  established_year       Int?
  /// letterhead and logo for generated documents
  logo_document_id       String?  @db.Uuid
  letterhead_document_id String?  @db.Uuid
  facebook_url           String?  @db.VarChar(300)
  youtube_url            String?  @db.VarChar(300)
  instagram_url          String?  @db.VarChar(300)
  linkedin_url           String?  @db.VarChar(300)
  /// public website switches
  public_show_prices     Boolean  @default(true)
  public_show_share_sale Boolean  @default(false)
  default_currency       String   @default("BDT") @db.VarChar(8)
  notes                  String?
  created_at             DateTime @default(now()) @db.Timestamptz
  updated_at             DateTime @updatedAt @db.Timestamptz
  created_by             String?  @db.Uuid

  @@map("company_settings")
}

/**
 * ------------------------------------------------------------------ *
 * People, access and sessions
 * ------------------------------------------------------------------
 */

enum UserStatus {
  active
  suspended
}

/// A role the client defines. The codes of the roles seeded at install match
/// the role names the UI has always used, so `domain/access.ts` keeps working;
/// after that the client adds, renames and re-permissions roles themselves.
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?
  /// a seeded role: its permissions may change, the code may not
  is_system   Boolean  @default(false)
  sort_order  Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz
  created_by  String?  @db.Uuid

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

/// What a role may do in one module. `level` is the permission vocabulary the
/// UI already speaks: none | view | own | edit | full.
model RolePermission {
  id         String   @id @default(uuid(7)) @db.Uuid
  role_id    String   @db.Uuid
  module     String   @db.VarChar(64)
  level      String   @db.VarChar(16)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz
  created_by String?  @db.Uuid

  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, module])
  @@map("role_permissions")
}

/// Staff who sign in to the Admin Portal.
model User {
  id                   String     @id @default(uuid(7)) @db.Uuid
  name                 String     @db.VarChar(200)
  phone                String     @unique @db.VarChar(20)
  email                String?    @unique @db.VarChar(200)
  /// argon2id. Null until the person sets one from their invitation.
  password_hash        String?
  must_change_password Boolean    @default(false)
  role_code            String     @db.VarChar(64)
  status               UserStatus @default(active)
  last_login_at        DateTime?  @db.Timestamptz
  created_at           DateTime   @default(now()) @db.Timestamptz
  updated_at           DateTime   @updatedAt @db.Timestamptz
  created_by           String?    @db.Uuid
  deleted_at           DateTime?  @db.Timestamptz

  role     Role                    @relation(fields: [role_code], references: [code])
  projects UserProjectAssignment[]
  sessions Session[]
  managed  Project[]               @relation("project_manager")

  @@index([status])
  @@map("users")
}

/// Which projects a user is scoped to. No rows = every project.
model UserProjectAssignment {
  id         String   @id @default(uuid(7)) @db.Uuid
  user_id    String   @db.Uuid
  project_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz
  created_by String?  @db.Uuid

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([user_id, project_id])
  @@map("user_project_assignments")
}

enum SessionKind {
  /// a staff member in the Admin Portal
  staff
  /// an investor in the Customer Portal or a mobile app
  customer
}

/// One signed-in device. The token is opaque and only its hash is stored, so a
/// leaked database row cannot be replayed as a session; revocation is a single
/// UPDATE, which is why this is not a JWT.
model Session {
  id           String      @id @default(uuid(7)) @db.Uuid
  kind         SessionKind
  user_id      String?     @db.Uuid
  customer_id  String?     @db.Uuid
  token_hash   String      @unique
  /// what the person is signing in from, for "sign out my lost phone"
  device       String?     @db.VarChar(200)
  ip           String?     @db.VarChar(64)
  expires_at   DateTime    @db.Timestamptz
  revoked_at   DateTime?   @db.Timestamptz
  last_seen_at DateTime?   @db.Timestamptz
  created_at   DateTime    @default(now()) @db.Timestamptz
  updated_at   DateTime    @updatedAt @db.Timestamptz
  created_by   String?     @db.Uuid

  user User? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([customer_id])
  @@index([expires_at])
  @@map("sessions")
}

/// A one-time code sent to a mobile number. Hashed, short-lived, attempt-capped.
model OtpCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  phone       String    @db.VarChar(20)
  code_hash   String
  /// what signing in with this code is for
  purpose     String    @db.VarChar(32)
  expires_at  DateTime  @db.Timestamptz
  attempts    Int       @default(0)
  consumed_at DateTime? @db.Timestamptz
  ip          String?   @db.VarChar(64)
  created_at  DateTime  @default(now()) @db.Timestamptz
  updated_at  DateTime  @updatedAt @db.Timestamptz
  created_by  String?   @db.Uuid

  @@index([phone, created_at])
  @@index([expires_at])
  @@map("otp_codes")
}

/// Every sign-in and OTP attempt, for the rate limiter and for the record of
/// who tried to get in. Postgres-backed on purpose: one fewer service to run.
model AuthAttempt {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// 'login' | 'otp_request' | 'otp_verify'
  kind       String   @db.VarChar(32)
  /// phone, email or whatever was typed — never the password
  identifier String?  @db.VarChar(200)
  ip         String?  @db.VarChar(64)
  ok         Boolean
  reason     String?  @db.VarChar(120)
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([kind, identifier, created_at])
  @@index([kind, ip, created_at])
  @@map("auth_attempts")
}

/**
 * ------------------------------------------------------------------ *
 * Audit trail and display-code numbering
 * ------------------------------------------------------------------
 */

enum AuditAction {
  create
  update
  delete
  login
  logout
  login_failed
  permission_change
  export
}

/// Append-only. Written by a Prisma extension inside the same transaction as
/// the change itself, so no service can forget it. The application's database
/// role has INSERT and SELECT here and nothing else.
model AuditLog {
  id                String      @id @default(uuid(7)) @db.Uuid
  at                DateTime    @default(now()) @db.Timestamptz
  action            AuditAction
  /// who did it: a staff user, a customer, or neither for a system job
  actor_user_id     String?     @db.Uuid
  actor_customer_id String?     @db.Uuid
  actor_role        String?     @db.VarChar(64)
  table_name        String      @db.VarChar(64)
  record_id         String?     @db.Uuid
  /// the record's display code, so a deleted row is still recognisable
  record_code       String?     @db.VarChar(40)
  before            Json?
  after             Json?
  ip                String?     @db.VarChar(64)
  user_agent        String?     @db.VarChar(300)
  request_id        String?     @db.VarChar(64)

  @@index([table_name, record_id])
  @@index([actor_user_id, at])
  @@index([at])
  @@map("audit_log")
}

/// The next number in a display-code series (PRJ-2026-001, SHR-2026-014).
///
/// A code is allocated by `UPDATE ... SET next_no = next_no + 1 RETURNING`
/// inside the transaction that writes the record, so two people saving at once
/// cannot take the same number. Gaps only appear when a transaction rolls
/// back; a nightly job reports them rather than filling them in.
model CodeSeries {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// what is being numbered, e.g. 'project', 'share_sale'
  module     String   @db.VarChar(64)
  prefix     String   @db.VarChar(16)
  /// the year (or other period) the series restarts on, e.g. '2026'
  period     String   @db.VarChar(16)
  next_no    Int      @default(1)
  /// how many digits the number is padded to
  width      Int      @default(3)
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz

  @@unique([module, period])
  @@map("code_series")
}

/**
 * ------------------------------------------------------------------ *
 * Documents
 * ------------------------------------------------------------------
 */

/// A file against any record. The bytes live in object storage (S3/R2 in
/// production, a local folder in development) behind `server/storage`; this row
/// holds where they are and what they are.
model Document {
  id               String    @id @default(uuid(7)) @db.Uuid
  entity_type      String    @db.VarChar(40)
  entity_id        String    @db.Uuid
  document_type    String    @db.VarChar(64)
  custom_type_name String?   @db.VarChar(120)
  /// the storage key, not a public URL — files are served through the API
  storage_key      String?   @db.VarChar(400)
  /// for a document that lives somewhere else entirely
  external_url     String?   @db.VarChar(400)
  file_name        String?   @db.VarChar(260)
  file_size        Int?
  mime_type        String?   @db.VarChar(120)
  /// generated papers (agreement, receipt) carry their own number
  document_no      String?   @db.VarChar(40)
  /// true only for files the public website or the investor portal may serve
  is_public        Boolean   @default(false)
  notes            String?
  uploaded_by      String?   @db.Uuid
  uploaded_at      DateTime  @default(now()) @db.Timestamptz
  created_at       DateTime  @default(now()) @db.Timestamptz
  updated_at       DateTime  @updatedAt @db.Timestamptz
  created_by       String?   @db.Uuid
  deleted_at       DateTime? @db.Timestamptz

  @@index([entity_type, entity_id])
  @@index([document_type])
  @@map("documents")
}

/**
 * ------------------------------------------------------------------ *
 * Projects
 * ------------------------------------------------------------------
 */

enum ProjectType {
  land_share
  plot_development
  apartment
  commercial
  mixed
}

/// Kept as the prototype wrote it so inherited records and labels still line
/// up, even though Phase 1 switches the status *flow* off: a project stays on
/// `planning` unless somebody moves it deliberately.
enum ProjectStatus {
  planning
  design
  approval
  under_construction
  nearly_complete
  handover_ongoing
  closed
}

enum ProjectSalesStatus {
  not_open
  open
  paused
  sold_out
}

enum LandSizeUnit {
  katha
  bigha
  decimal
}

/// What happens to the land after its shares are sold.
enum ConstructionAfterSale {
  undecided
  planned
  none
}

/// The project is the thing shares are sold in: a master record, the money it
/// earns, and its papers. Land, towers, units and the JV allocation belong to
/// the modules this product does not carry (AGENTS.md).
model Project {
  id                          String                @id @default(uuid(7)) @db.Uuid
  code                        String                @unique @db.VarChar(40)
  name                        String                @db.VarChar(200)
  project_type                ProjectType           @default(land_share)
  status                      ProjectStatus         @default(planning)
  sales_status                ProjectSalesStatus    @default(not_open)
  /// a fact typed on the project in Phase 1; a link to the Land module in Phase 2
  total_land_area             Decimal?              @db.Decimal(14, 2)
  total_land_area_unit        LandSizeUnit?
  /// the marketing address the public site shows, not a cadastral one
  location_summary            String?               @db.VarChar(300)
  expected_start_date         DateTime?             @db.Date
  expected_completion_date    DateTime?             @db.Date
  project_manager_id          String?               @db.Uuid
  architect                   String?               @db.VarChar(200)
  surroundings                String?
  /// multi-select from lookup_values (category='amenity')
  amenities                   String[]              @default([])
  /// an externally hosted display picture; an uploaded one is a Document
  cover_image_url             String?               @db.VarChar(400)
  cover_image_document_id     String?               @db.Uuid
  construction_after_sale     ConstructionAfterSale @default(undecided)
  /// the late fee a new share agreement on this project starts from
  default_late_fee_pct        Decimal?              @db.Decimal(6, 3)
  default_late_fee_grace_days Int?
  is_public                   Boolean               @default(false)
  is_featured                 Boolean               @default(false)
  created_at                  DateTime              @default(now()) @db.Timestamptz
  updated_at                  DateTime              @updatedAt @db.Timestamptz
  created_by                  String?               @db.Uuid
  deleted_at                  DateTime?             @db.Timestamptz

  manager     User?                   @relation("project_manager", fields: [project_manager_id], references: [id])
  assignments UserProjectAssignment[]
  offerings   ShareOffering[]
  share_sales ShareSale[]

  @@index([status])
  @@index([sales_status])
  @@index([is_public, is_featured])
  @@index([created_at])
  @@map("projects")
}

/**
 * ------------------------------------------------------------------ *
 * Share sale (S2) — PROJECT-SHARE-SALE-PLAN.md
 * The money half of this product: a project is valued, a round of shares is
 * offered, a customer reserves some, an agreement fixes the schedule, and the
 * payments come in against it.
 * Field names are the ones the interim Dexie layer already used, so the
 * screens and `src/lib/domain/share-sale.ts` read the same thing after the
 * move as before it (AGENTS.md). What changes is where the rules live and
 * what the types are: money is Decimal(18,2), a share percentage is
 * Decimal(9,6), and nothing is summed in JavaScript floats.
 * ------------------------------------------------------------------
 */

enum CustomerType {
  /// buys a flat or a plot — Phase 2
  buyer
  /// buys shares in a project: this product's customer
  investor
}

/// A person or company on the platform. One customer, many purchases, across
/// projects (plan §4 step 9), so nothing about a purchase lives here.
model Customer {
  id            String       @id @default(uuid(7)) @db.Uuid
  code          String       @unique @db.VarChar(40)
  name          String       @db.VarChar(200)
  /// the same dedup idea as leads: one person, one record
  phone         String       @unique @db.VarChar(20)
  email         String?      @db.VarChar(200)
  customer_type CustomerType @default(investor)
  /// which lead this customer was converted from, for traceability
  lead_id       String?      @db.Uuid

  /// KYC as the agreement names a person (plan §4a). All optional: the portal
  /// shows "not on file" for whatever the office has not filled in.
  nid                   String?   @db.VarChar(40)
  tin                   String?   @db.VarChar(40)
  date_of_birth         DateTime? @db.Date
  father_or_spouse_name String?   @db.VarChar(200)
  profession            String?   @db.VarChar(120)
  address               String?
  permanent_address     String?
  kyc_verified_on       DateTime? @db.Date

  /// the nominee named on the agreement
  nominee_name     String? @db.VarChar(200)
  nominee_relation String? @db.VarChar(80)
  nominee_phone    String? @db.VarChar(20)
  nominee_nid      String? @db.VarChar(40)

  /// where a profit payout or a refund is sent
  bank_name    String? @db.VarChar(160)
  bank_branch  String? @db.VarChar(160)
  bank_account String? @db.VarChar(60)

  /// the Customer Portal sign-in, once the invitation has been accepted
  password_hash        String?
  must_change_password Boolean   @default(false)
  last_login_at        DateTime? @db.Timestamptz

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  created_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz

  sales ShareSale[]

  @@index([name])
  @@index([created_at])
  @@map("customers")
}

enum ShareOfferingStatus {
  draft
  open
  closed
  cancelled
}

enum ShareFrequency {
  monthly
  quarterly
}

/// How an offering charges a late installment (SHARE-SALE-FEEDBACK-PLAN.md A3).
enum LateFeeType {
  /// a percentage of the overdue installment, charged once
  pct_once
  /// a fixed taka amount, charged once
  fixed_once
}

/// One round of shares in one project (plan §4 step 2).
///
/// The valuation is kept on the round, with its date, rather than on the
/// project: a project revalued between rounds must not rewrite what the first
/// round's buyers agreed to. `share_pct` and `price_per_share` are stored, not
/// derived on read, for the same reason.
model ShareOffering {
  id         String @id @default(uuid(7)) @db.Uuid
  code       String @unique @db.VarChar(40)
  project_id String @db.Uuid
  /// 1 for the project's first offering, then 2, 3…
  round_no   Int

  /// valuation = net asset value + premium: the worth of 100% of the project
  net_asset_value Decimal  @db.Decimal(18, 2)
  premium_value   Decimal  @default(0) @db.Decimal(18, 2)
  valuation       Decimal  @db.Decimal(18, 2)
  valuation_date  DateTime @db.Date

  /// % of the whole project offered in this round
  offered_pct     Decimal @db.Decimal(9, 6)
  total_shares    Int
  /// what one share owns, in % — offered_pct divided by total_shares
  share_pct       Decimal @db.Decimal(9, 6)
  /// valuation times share_pct, to the taka
  price_per_share Decimal @db.Decimal(18, 2)

  /// how many days the round stays open once opened
  validity_days Int       @default(120)
  opens_on      DateTime? @db.Date
  /// planned while a draft; fixed when the round is opened
  closes_on     DateTime? @db.Date

  /// per customer
  min_shares            Int            @default(1)
  max_shares            Int?
  /// the least down payment accepted, % of the price
  min_down_payment_pct  Decimal        @default(0) @db.Decimal(6, 3)
  /// the longest plan offered; an agreement may choose fewer
  max_installments      Int            @default(0)
  installment_frequency ShareFrequency @default(monthly)

  late_fee_type   LateFeeType @default(pct_once)
  /// with pct_once: % of the overdue installment
  late_fee_pct    Decimal     @default(0) @db.Decimal(6, 3)
  /// with fixed_once: the taka charged once on each late installment
  late_fee_amount Decimal?    @db.Decimal(18, 2)
  grace_days      Int         @default(0)
  /// how long reserved shares are held before the agreement is signed
  hold_days       Int         @default(7)

  status ShareOfferingStatus @default(draft)
  notes  String?

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  created_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz

  project Project     @relation(fields: [project_id], references: [id])
  sales   ShareSale[]

  @@unique([project_id, round_no])
  @@index([project_id, status])
  @@index([status])
  @@map("share_offerings")
}

/// Stored stages of one purchase (plan §6). "Paying" and "overdue" are read
/// off the schedule rather than stored, so no job has to keep them true.
enum ShareSaleStatus {
  /// shares held for this customer while the agreement is prepared
  reserved
  agreement_signed
  fully_paid
  /// the hold lapsed; the shares went back to the round
  released
  cancelled
}

/// One customer's purchase in one round.
model ShareSale {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique @db.VarChar(40)
  offering_id String @db.Uuid
  /// denormalised from the offering: every money report is per project, and a
  /// purchase can never move to another one
  project_id  String @db.Uuid
  customer_id String @db.Uuid

  shares                Int
  /// what one share owned at the time of this purchase
  share_pct             Decimal        @db.Decimal(9, 6)
  price_per_share       Decimal        @db.Decimal(18, 2)
  total_price           Decimal        @db.Decimal(18, 2)
  down_payment          Decimal        @default(0) @db.Decimal(18, 2)
  /// after the down payment; 0 = the whole price at signing
  installment_count     Int            @default(0)
  installment_frequency ShareFrequency @default(monthly)

  reserved_on DateTime @db.Date
  hold_until  DateTime @db.Date

  agreement_no     String?   @unique @db.VarChar(40)
  agreement_date   DateTime? @db.Date
  /// the first installment's due date; the rest follow by the frequency
  first_due_date   DateTime? @db.Date
  certificate_no   String?   @unique @db.VarChar(40)
  certificate_date DateTime? @db.Date

  status      ShareSaleStatus @default(reserved)
  /// why it was released or cancelled
  status_note String?
  notes       String?

  /// What the office recorded at the signing table (plan section 4a): place,
  /// witnesses, stamp and notary. One row of the agreement's own facts, which
  /// nothing queries across purchases — so Json, not six more tables.
  signing    Json?
  /// the signing as far as the office has got with it, saved at every step
  sign_draft Json?

  /// the sales organisation member who sold it (REVENUE-SHARE-PLAN.md section 6)
  sold_by_member_id String? @db.Uuid

  created_at DateTime  @default(now()) @db.Timestamptz
  updated_at DateTime  @updatedAt @db.Timestamptz
  created_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz

  offering     ShareOffering      @relation(fields: [offering_id], references: [id])
  project      Project            @relation(fields: [project_id], references: [id])
  customer     Customer           @relation(fields: [customer_id], references: [id])
  installments ShareInstallment[]
  payments     SharePayment[]

  @@index([offering_id, status])
  @@index([project_id, status])
  @@index([customer_id])
  @@index([sold_by_member_id])
  @@map("share_sales")
}

/// One row of the agreed payment schedule. `seq` 0 is the down payment.
///
/// Not a financial record: it is what was *agreed*, and it may be rewritten
/// while a purchase is still being arranged. What was *paid* is a
/// SharePayment, and that is immutable.
model ShareInstallment {
  id       String   @id @default(uuid(7)) @db.Uuid
  sale_id  String   @db.Uuid
  /// 0 = down payment, then 1, 2, 3…
  seq      Int
  due_date DateTime @db.Date
  amount   Decimal  @db.Decimal(18, 2)

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz
  created_by String?  @db.Uuid

  sale        ShareSale                @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  allocations SharePaymentAllocation[]

  @@unique([sale_id, seq])
  @@index([due_date])
  @@map("share_installments")
}

enum SharePaymentMethod {
  bank_transfer
  cheque
  cash
  bkash
  nagad
  card
  online
  /// a declared profit share paid onto overdue installments; no money moves
  profit_adjustment
}

enum SharePaymentChannel {
  /// recorded by the office
  office
  /// paid by the customer through the portal's gateway
  online
}

/// Money received against a purchase — a receipt.
///
/// Immutable, enforced by a trigger: no UPDATE, no DELETE, no `deleted_at`
/// (AGENTS.md). A mistake is corrected by a reversing payment that points at
/// the one it reverses, so the receipt book reads like a receipt book. Whether
/// a payment has been reversed is therefore read, never stored.
model SharePayment {
  id      String   @id @default(uuid(7)) @db.Uuid
  code    String   @unique @db.VarChar(40)
  sale_id String   @db.Uuid
  paid_on DateTime @db.Date

  /// principal + late_fee; negative on a reversal
  amount    Decimal @db.Decimal(18, 2)
  principal Decimal @db.Decimal(18, 2)
  late_fee  Decimal @default(0) @db.Decimal(18, 2)

  method        SharePaymentMethod
  reference     String?             @db.VarChar(120)
  channel       SharePaymentChannel @default(office)
  /// "bKash 01711 xxx 344", "Visa xxxx 4242": what the gateway reported
  method_detail String?             @db.VarChar(160)
  /// the account the money landed in, so investor money reaches Cash Position
  account_id    String?             @db.Uuid
  notes         String?

  /// set on a reversal: the receipt being corrected
  reverses_payment_id String? @db.Uuid

  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @updatedAt @db.Timestamptz
  created_by String?  @db.Uuid

  sale        ShareSale                @relation(fields: [sale_id], references: [id])
  reverses    SharePayment?            @relation("payment_reversal", fields: [reverses_payment_id], references: [id])
  reversed_by SharePayment[]           @relation("payment_reversal")
  allocations SharePaymentAllocation[]

  @@index([sale_id, paid_on])
  @@index([paid_on])
  @@index([account_id])
  @@map("share_payments")
}

/// How much of one payment went onto one scheduled row.
///
/// A table rather than the Json array the interim layer kept, because "what is
/// still owed on installment 4" is a question the database should answer with
/// a SUM — not something every screen re-adds in JavaScript. Immutable with
/// the payment it belongs to.
model SharePaymentAllocation {
  id             String  @id @default(uuid(7)) @db.Uuid
  payment_id     String  @db.Uuid
  installment_id String  @db.Uuid
  principal      Decimal @db.Decimal(18, 2)
  late_fee       Decimal @default(0) @db.Decimal(18, 2)

  created_at DateTime @default(now()) @db.Timestamptz

  payment     SharePayment     @relation(fields: [payment_id], references: [id])
  installment ShareInstallment @relation(fields: [installment_id], references: [id])

  @@index([payment_id])
  @@index([installment_id])
  @@map("share_payment_allocations")
}
